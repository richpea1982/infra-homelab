<file path="terraform/main.tf">
# ==============================================================================
# STAGE 1: Parallel Deployment (Local Host Storage)
# ==============================================================================
# This block continues to deploy all 3 K3s nodes in parallel across pve2, 3, and 4
module "k3s_node" {
  source   = "./modules/vm"
  for_each = var.k3s_nodes

  hostname       = "k3s-${each.key}"
  node_name      = each.value.node_name
  vmid           = each.value.vmid
  ip             = each.value.ip
  gateway        = each.value.gateway
  vlan_id        = each.value.vlan_id
  cores          = each.value.cores
  memory         = each.value.memory
  disk_size      = each.value.disk_size
  datastore_id   = each.value.datastore
  ssh_public_key = local.ssh_public_key
}

# ==============================================================================
# STAGE 2: Serial Deployment (Ceph Pool - One at a Time)
# ==============================================================================

# First Ceph VM: Waits for all Stage 1 local K3s nodes to fully finish
module "wordpress_hantaweb" {
  source = "./modules/vm"

  hostname       = "hantaweb"
  node_name      = var.wordpress_sites["hantaweb"].node_name
  vmid           = var.wordpress_sites["hantaweb"].vmid
  ip             = var.wordpress_sites["hantaweb"].ip
  gateway        = var.wordpress_sites["hantaweb"].gateway
  vlan_id        = var.wordpress_sites["hantaweb"].vlan_id
  cores          = var.wordpress_sites["hantaweb"].cores
  memory         = var.wordpress_sites["hantaweb"].memory
  disk_size      = var.wordpress_sites["hantaweb"].disk_size
  datastore_id   = var.wordpress_sites["hantaweb"].datastore
  ssh_public_key = local.ssh_public_key

  # Enforce Stage 1 completion
  depends_on = [module.k3s_node]
}

# Second Ceph VM: Explicitly waits for hantaweb to completely finish first
module "wordpress_petitsanglais" {
  source = "./modules/vm"

  hostname       = "petitsanglais"
  node_name      = var.wordpress_sites["petitsanglais"].node_name
  vmid           = var.wordpress_sites["petitsanglais"].vmid
  ip             = var.wordpress_sites["petitsanglais"].ip
  gateway        = var.wordpress_sites["petitsanglais"].gateway
  vlan_id        = var.wordpress_sites["petitsanglais"].vlan_id
  cores          = var.wordpress_sites["petitsanglais"].cores
  memory         = var.wordpress_sites["petitsanglais"].memory
  disk_size      = var.wordpress_sites["petitsanglais"].disk_size
  datastore_id   = var.wordpress_sites["petitsanglais"].datastore
  ssh_public_key = local.ssh_public_key

  # Enforce serial order within Stage 2 to protect Ceph IOPS
  depends_on = [module.wordpress_hantaweb]
}

# Second Ceph VM: Explicitly waits for petitsanglais to completely finish first
module "wordpress_hantaassos" {
  source = "./modules/vm"

  hostname       = "hanta-assos"
  node_name      = var.wordpress_sites["hanta-assos"].node_name
  vmid           = var.wordpress_sites["hanta-assos"].vmid
  ip             = var.wordpress_sites["hanta-assos"].ip
  gateway        = var.wordpress_sites["hanta-assos"].gateway
  vlan_id        = var.wordpress_sites["hanta-assos"].vlan_id
  cores          = var.wordpress_sites["hanta-assos"].cores
  memory         = var.wordpress_sites["hanta-assos"].memory
  disk_size      = var.wordpress_sites["hanta-assos"].disk_size
  datastore_id   = var.wordpress_sites["hanta-assos"].datastore
  ssh_public_key = local.ssh_public_key

  # Enforce serial order within Stage 2 to protect Ceph IOPS
  depends_on = [module.wordpress_petitsanglais]
}

# ==============================================================================
# Append this block to your existing terraform/main.tf
# ==============================================================================

resource "proxmox_virtual_environment_download_file" "debian_13_lxc_template" {
  content_type = "vztmpl"
  datastore_id = "local"
  node_name    = "pve2"
  url          = "http://download.proxmox.com/images/system/debian-13-standard_13.1-2_amd64.tar.zst"
}

module "media_lxc" {
  source   = "./modules/lxc"
  for_each = var.media_lxc

  hostname         = each.value.hostname
  node_name        = each.value.node_name
  vmid             = each.value.vmid
  unprivileged     = each.value.unprivileged
  cores            = each.value.cores
  memory           = each.value.memory
  disk_size        = each.value.disk_size
  datastore_id     = each.value.datastore
  ip               = each.value.ip
  gateway          = each.value.gateway
  vlan_id          = each.value.vlan_id
  ssh_public_key   = local.ssh_public_key
  template_file_id = proxmox_virtual_environment_download_file.debian_13_lxc_template.id
  mount_nfs        = true
  # device_passthrough deliberately NOT passed — Proxmox rejects this over
  # API token auth (root@pam or not) at container-create time. Applied
  # post-creation via SSH in null_resource.media_lxc_post_config below.
}

resource "null_resource" "media_lxc_post_config" {
  for_each = var.media_lxc

  depends_on = [module.media_lxc]

  triggers = {
    vmid = module.media_lxc[each.key].vm_id
    mac  = module.media_lxc[each.key].mac_address
  }

  connection {
    type        = "ssh"
    host        = "10.0.10.12"
    user        = "root"
    private_key = base64decode(var.ssh_private_key_base64)
  }

  provisioner "remote-exec" {
    inline = concat(
      ["pct set ${module.media_lxc[each.key].vm_id} --features nesting=0,mount=nfs"],
      [
        for idx, dev in each.value.device_passthrough :
        "pct set ${module.media_lxc[each.key].vm_id} -dev${idx} path=${dev.path}"
      ],
      # Feature/config changes (mount permissions especially) are applied
      # to a privileged container's AppArmor/cgroup profile at start time,
      # not hot-reloaded into an already-running container. pct set writes
      # the config correctly but the running instance won't reflect it
      # until restarted — confirmed the hard way on the Jellyfin container
      # (mount=nfs was present in `pct config` but NFS mounts didn't work
      # until a manual restart).
      ["pct reboot ${module.media_lxc[each.key].vm_id}"]
    )
  }
}
</file>

<file path="ansible/roles/jellyfin/tasks/main.yml">
---
# roles/jellyfin/tasks/main.yml
# Provisioning tasks for Jellyfin LXC. Uses direct .list file writes for apt sources
# to avoid ansible version differences around deb822_repository/apt_repository.

- name: Verify GPU device nodes were actually passed through
  ansible.builtin.stat:
    path: "{{ item }}"
  loop:
    - /dev/dri/card1
    - /dev/dri/renderD128
  register: gpu_device_check

- name: Fail if no GPU device nodes were passed through
  ansible.builtin.fail:
    msg: "Expected GPU device nodes not present: ensure Proxmox device_passthrough is configured for this container."
  when: >
    (gpu_device_check.results | selectattr('stat.exists') | list | length) == 0

- name: Determine if any GPU device node exists
  ansible.builtin.set_fact:
    gpu_present: "{{ (gpu_device_check.results | selectattr('stat.exists') | list | length) > 0 }}"

- name: Ensure Debian non-free sources list exists (fallback for older Ansible)
  become: true
  ansible.builtin.copy:
    dest: /etc/apt/sources.list.d/debian_nonfree.list
    content: |
      deb http://deb.debian.org/debian {{ (ansible_facts['distribution_release'] | default(ansible_facts['lsb']['codename'] | default('bookworm'))) }} main contrib non-free
    mode: '0644'
  when: ansible_facts['os_family'] == "Debian"

- name: Ensure Debian security non-free sources list exists (fallback)
  become: true
  ansible.builtin.copy:
    dest: /etc/apt/sources.list.d/debian_nonfree_security.list
    content: |
      deb http://security.debian.org/debian-security {{ (ansible_facts['distribution_release'] | default(ansible_facts['lsb']['codename'] | default('bookworm'))) }}-security main contrib non-free
    mode: '0644'
  when: ansible_facts['os_family'] == "Debian"

- name: Update apt cache after adding non-free repos
  become: true
  ansible.builtin.apt:
    update_cache: yes
    cache_valid_time: 3600
  when: ansible_facts['os_family'] == "Debian"

- name: Try to install available VAAPI/QSV packages (only if GPU present)
  become: true
  block:
    - name: Attempt to install candidate VAAPI packages
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
      loop:
        - intel-media-va-driver-non-free
        - intel-media-va-driver
        - i965-va-driver
        - vainfo
        - nfs-common
      register: va_install_results
      failed_when: false

    - name: Set va_installed fact if any candidate is present or was installed
      ansible.builtin.set_fact:
        va_installed: >-
          {{ (va_install_results.results | selectattr('changed') | list | length) > 0
             or (va_install_results.results | selectattr('rc', 'defined') | selectattr('rc', 'equalto', 0) | list | length > 0) }}

    - name: Debug VA install results (helpful when troubleshooting)
      ansible.builtin.debug:
        var: va_install_results
      when: va_install_results is defined and va_install_results.results | length > 0

    - name: Fail if GPU present but no VAAPI package available
      ansible.builtin.fail:
        msg: >
          No VAAPI package available in apt sources. Ensure non-free is enabled
          in the template or use a different template/storage.
      when: not va_installed
  when:
    - ansible_facts['os_family'] == "Debian"
    - gpu_present

- name: Install VAAPI/QSV userspace driver and diagnostic tools (ensure vainfo present if available)
  become: true
  ansible.builtin.apt:
    name:
      - vainfo
    state: present
    update_cache: true
  when:
    - ansible_facts['os_family'] == "Debian"
    - gpu_present
    - va_installed | default(false)

- name: Verify QSV profiles are visible via vainfo (fails loudly if passthrough is broken at the driver level)
  ansible.builtin.command: vainfo
  register: vainfo_result
  changed_when: false
  failed_when: "'VAProfile' not in vainfo_result.stdout"
  when:
    - gpu_present
    - va_installed | default(false)

- name: Ensure media library mount points exist
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /mnt/jellyfin-media
    - /mnt/jellyfin-media/dvds
    - /mnt/jellyfin-media/music

- name: Mount NAS-backed media library exports (matches nas_setup's jellyfin/dvds/music datasets)
  ansible.posix.mount:
    path: "{{ item.path }}"
    src: "10.0.10.15:{{ item.export }}"
    fstype: nfs
    opts: "rw,soft,timeo=30"
    state: mounted
  loop:
    - { path: /mnt/jellyfin-media,            export: /mnt/storage/jellyfin }
    - { path: /mnt/jellyfin-media/dvds,        export: /mnt/storage/jellyfin/dvds }
    - { path: /mnt/jellyfin-media/music,       export: /mnt/storage/jellyfin/music }

- name: Add Jellyfin apt repository signing key
  become: true
  ansible.builtin.get_url:
    url: https://repo.jellyfin.org/jellyfin_team.gpg.key
    dest: /usr/share/keyrings/jellyfin.gpg
    mode: '0644'

- name: Add Jellyfin apt repository (fallback .list)
  become: true
  ansible.builtin.copy:
    dest: /etc/apt/sources.list.d/jellyfin.list
    content: |
      deb [signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/debian {{ (ansible_facts['distribution_release'] | default(ansible_facts['lsb']['codename'] | default('bookworm'))) }} main
    mode: '0644'
  when: ansible_facts['os_family'] == "Debian"

- name: Update apt cache after adding jellyfin repo
  become: true
  ansible.builtin.apt:
    update_cache: yes
  when: ansible_facts['os_family'] == "Debian"

- name: Install Jellyfin
  ansible.builtin.apt:
    name: jellyfin
    state: present
    update_cache: true

- name: Ensure container has a group matching the device node's numeric GID and add jellyfin to it
  block:
    - name: Stat device node to get numeric GID
      ansible.builtin.stat:
        path: /dev/dri/renderD128
      register: render_dev_stat
      when: gpu_present

    - name: Set device_gid fact
      ansible.builtin.set_fact:
        device_gid: "{{ render_dev_stat.stat.gid | int }}"
      when:
        - gpu_present
        - render_dev_stat.stat is defined

    - name: Lookup group name for device_gid (if any)
      ansible.builtin.command:
        cmd: "getent group {{ device_gid }}"
      register: getent_group
      failed_when: false
      changed_when: false
      when: device_gid is defined

    - name: Set existing_group_name fact if getent returned a group
      ansible.builtin.set_fact:
        existing_group_name: "{{ (getent_group.stdout.split(':')[0]) if (getent_group.stdout|length > 0) else '' }}"
      when: device_gid is defined

    - name: Create group with host device GID if none exists
      ansible.builtin.group:
        name: "{{ existing_group_name | default('render') }}"
        gid: "{{ device_gid }}"
        state: present
      when:
        - device_gid is defined
        - existing_group_name == ''

    - name: Add jellyfin user to device group (by name)
      ansible.builtin.user:
        name: jellyfin
        groups: "{{ existing_group_name | default('render') }}"
        append: true
      when: device_gid is defined

    - name: Restart jellyfin to pick up new group membership
      ansible.builtin.systemd:
        name: jellyfin
        state: restarted
      when: device_gid is defined
  when: gpu_present
</file>

<file path="ansible/roles/k3s_cluster/tasks/apps.yml">
---
- name: Create local execution bin paths for Helm management
  file:
    path: /root/.kube
    state: directory
    mode: '0700'

- name: Create symbolic link to cluster credentials for default actions
  file:
    src: "{{ k3s_kubeconfig_path }}"
    dest: /root/.kube/config
    state: link

- name: Install helm components on control host
  unarchive:
    src: "https://get.helm.sh/helm-v3.14.0-linux-amd64.tar.gz"
    dest: /tmp
    remote_src: yes

- name: Move helm binary into global pathing execution spots
  copy:
    src: /tmp/linux-amd64/helm
    dest: /usr/local/bin/helm
    mode: '0755'
    remote_src: yes

- name: Ensure python3-pip is available for the Kubernetes Python client
  apt:
    name: python3-pip
    state: present

- name: Install Kubernetes Python client (required by k8s / k8s_info modules)
  pip:
    name: kubernetes
    state: present
    extra_args: "--break-system-packages --ignore-installed"

# --- Deploy Calico (CNI) ---
# Genuine prerequisite, not a caution: no pod — including ArgoCD's own —
# can be scheduled without pod networking existing first.
- name: Wait for K3s API server proxy to accept connections on port 6444
  ansible.builtin.wait_for:
    host: "127.0.0.1"
    port: 6444
    delay: 5
    timeout: 60

- name: Pause briefly to let K3s API server stabilize completely
  ansible.builtin.pause:
    seconds: 10

- name: Add Calico (Tigera) Helm repository
  kubernetes.core.helm_repository:
    name: projectcalico
    repo_url: "https://projectcalico.docs.tigera.io/charts"
  environment:
    KUBECONFIG: /etc/rancher/k3s/k3s.yaml

- name: Install Calico CRDs (required separately as of v3.32+)
  kubernetes.core.helm:
    name: calico-crds
    chart_ref: projectcalico/crd.projectcalico.org.v1
    chart_version: "{{ calico_helm_version }}"
    release_namespace: tigera-operator
    create_namespace: true
  environment:
    KUBECONFIG: /etc/rancher/k3s/k3s.yaml
  register: result
  until: result is succeeded
  retries: 20
  delay: 15

- name: Deploy Calico CNI inside kube-system scope
  kubernetes.core.helm:
    name: calico
    chart_ref: projectcalico/tigera-operator
    chart_version: "{{ calico_helm_version }}"
    release_namespace: tigera-operator
    values:
      installation:
        calicoNetwork:
          ipPools:
            - cidr: "{{ k3s_cluster_cidr }}"
              encapsulation: VXLAN
  environment:
    KUBECONFIG: /etc/rancher/k3s/k3s.yaml

- name: Wait for Calico node pods to be Running before continuing
  kubernetes.core.k8s_info:
    kind: Pod
    namespace: calico-system
    label_selectors:
      - "k8s-app=calico-node"
  register: calico_pods
  until: >
    calico_pods.resources | length > 0 and
    calico_pods.resources | map(attribute='status.phase') | unique == ['Running']
  retries: 30
  delay: 10

# --- Deploy ArgoCD ---
# This is the last thing Ansible installs directly. Everything after this
# point is GitOps-managed — Ansible does not touch Traefik, CrowdSec, or
# any future workload again.
- name: Add ArgoCD Helm repository
  kubernetes.core.helm_repository:
    name: argo
    repo_url: "https://argoproj.github.io/argo-helm"
  environment:
    KUBECONFIG: /etc/rancher/k3s/k3s.yaml

- name: Install ArgoCD
  kubernetes.core.helm:
    name: argocd
    chart_ref: argo/argo-cd
    chart_version: "{{ argocd_helm_version }}"
    release_namespace: argocd
    create_namespace: true
    values:
      configs:
        params:
          "server.insecure": true
      controller:
        podLabels:
          workload-tier: memory-heavy
        topologySpreadConstraints:
          - maxSkew: 1
            topologyKey: kubernetes.io/hostname
            whenUnsatisfiable: DoNotSchedule
            labelSelector:
              matchLabels:
                workload-tier: memory-heavy
  environment:
    KUBECONFIG: /etc/rancher/k3s/k3s.yaml

- name: Wait for the ArgoCD application controller to be Running
  kubernetes.core.k8s_info:
    kind: Pod
    namespace: argocd
    label_selectors:
      - "app.kubernetes.io/name=argocd-application-controller"
  register: argocd_pods
  until: >
    argocd_pods.resources | length > 0 and
    argocd_pods.resources | map(attribute='status.phase') | unique == ['Running']
  retries: 30
  delay: 10

# --- Bootstrap the App-of-Apps root Application ---
# From here on, ArgoCD reconciles everything under {{ gitops_repo_path }}
# in {{ gitops_repo_url }} on its own. Adding a new service later means
# committing a new file to that path — no further Ansible runs required.
- name: Apply the ArgoCD root Application (app-of-apps)
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: argoproj.io/v1alpha1
      kind: Application
      metadata:
        name: root-app
        namespace: argocd
      spec:
        project: default
        source:
          repoURL: "{{ gitops_repo_url }}"
          targetRevision: "{{ gitops_repo_revision }}"
          path: "{{ gitops_repo_path }}"
        destination:
          server: "https://kubernetes.default.svc"
          namespace: argocd
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
          syncOptions:
            - CreateNamespace=true
# --- Generate and register ArgoCD's GitOps deploy key ---
# Idempotent: openssh_keypair does not regenerate an existing key, so the
# public key registered with GitHub stays valid across every subsequent run.
- name: Ensure directory for ArgoCD's GitOps deploy key exists
  file:
    path: /etc/ansible-secrets
    state: directory
    mode: '0700'
    owner: root
    group: root

- name: Generate the ArgoCD GitOps deploy key (skipped if it already exists)
  community.crypto.openssh_keypair:
    path: /etc/ansible-secrets/argocd_k3s_deploy
    type: ed25519
    comment: "argocd-k3s-gitops"
    mode: '0600'

- name: Read the generated private key from the remote node
  ansible.builtin.slurp:
    src: /etc/ansible-secrets/argocd_k3s_deploy
  register: argocd_priv_key

- name: Register the K3s GitOps repo credentials with ArgoCD
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: Secret
      metadata:
        name: k3s-gitops-repo
        namespace: argocd
        labels:
          argocd.argoproj.io/secret-type: repository
      stringData:
        type: git
        url: "{{ gitops_repo_url }}"
        sshPrivateKey: "{{ argocd_priv_key['content'] | b64decode }}"

- name: Override default StorageClass reclaim policy
  include_tasks: storageclass-retain.yml

# Prep and setup for etcs snapshots to s3 bucket
- name: Ensure boto3/botocore are available for S3 bucket management
  ansible.builtin.pip:
    name:
      - boto3
      - botocore
    state: present
    extra_args: "--break-system-packages --ignore-installed"

- name: Ensure a MinIO bucket exists for etcd snapshots
  amazon.aws.s3_bucket:
    name: "{{ etcd_s3_bucket }}"
    state: present
    endpoint_url: "http://{{ etcd_s3_endpoint }}"
    aws_access_key: "{{ vault_minio_root_user }}"
    aws_secret_key: "{{ vault_minio_root_password }}"

- name: Create the etcd snapshot S3 config secret for k3s
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: Secret
      metadata:
        name: "{{ etcd_s3_config_secret }}"
        namespace: kube-system
      type: Opaque
      stringData:
        etcd-s3-endpoint: "{{ etcd_s3_endpoint }}"
        etcd-s3-insecure: "true"
        etcd-s3-bucket: "{{ etcd_s3_bucket }}"
        etcd-s3-access-key: "{{ vault_minio_root_user }}"
        etcd-s3-secret-key: "{{ vault_minio_root_password }}"
</file>

<file path="ansible/roles/k3s_cluster/tasks/bootstrap.yml">
---
# --- Local state check ---
- name: Check if K3s service is already active on this node
  ansible.builtin.systemd:
    name: k3s
  register: k3s_local_status
  failed_when: false

- name: Set fact — is K3s already running here?
  ansible.builtin.set_fact:
    k3s_already_running: "{{ k3s_local_status.status is defined and k3s_local_status.status.ActiveState == 'active' }}"

# --- Probe the VIP: does a cluster already exist without me? (I may have been rebuilt) ---
- name: Probe the VIP to check whether a cluster already exists
  ansible.builtin.uri:
    url: "https://{{ k3s_api_server }}:{{ k3s_api_port }}/readyz"
    validate_certs: false
    status_code: [200, 401, 403]
    timeout: 5
  register: vip_probe
  failed_when: false
  when: not k3s_already_running

- name: Set fact — does a cluster already exist and answer on the VIP?
  ansible.builtin.set_fact:
    cluster_exists: "{{ (vip_probe.status | default(0)) in [200, 401, 403] }}"
  when: not k3s_already_running

# --- Safety rail: refuse a requested restore against a still-live cluster ---
# A restore is destructive by design (--cluster-reset wipes this node's
# etcd member and reseeds it from the snapshot). If the VIP is still
# answering, a live cluster already exists — restoring now would fight
# it, not recover it. Fail closed rather than silently doing the wrong
# thing. Same "never let destructive automation run without a guard"
# lesson as the terraform -target incident, applied here.
- name: Refuse to restore if a live cluster is currently answering on the VIP
  ansible.builtin.fail:
    msg: >-
      k3s_restore_from_snapshot=true but {{ k3s_api_server }}:{{ k3s_api_port }}
      is currently answering — a live cluster already exists. Aborting
      rather than restoring over it. If you genuinely intend to replace a
      live cluster's state with an older snapshot, do that as a separate,
      deliberate action, not via this automatic path.
  when:
    - k3s_restore_from_snapshot | default(false)
    - cluster_exists | default(false)
    - not k3s_already_running

# --- Defensive cleanup before any path below — safe no-op on a
# genuinely fresh Terraform-provisioned VM, real work only if this node
# carries leftover state from a previous install/identity. ---
- name: Defensive cleanup of any prior k3s state before bootstrapping
  ansible.builtin.include_tasks: cleanup-stale-state.yml
  when: not k3s_already_running

# --- Path C: restore from an S3-hosted etcd snapshot (explicit opt-in only) ---
- name: Restore control plane from etcd snapshot (Path C — full cluster loss)
  ansible.builtin.include_tasks: restore.yml
  when:
    - k3s_restore_from_snapshot | default(false)
    - not (cluster_exists | default(false))
    - not k3s_already_running

- name: Set fact — did this run take the restore path?
  ansible.builtin.set_fact:
    k3s_did_restore: "{{ (k3s_restore_from_snapshot | default(false)) and not (cluster_exists | default(false)) and not k3s_already_running }}"

# --- Path A: rejoin existing cluster (this node was rebuilt; cluster survived on the VIP) ---
- name: Rejoin existing cluster (this node was rebuilt; cluster survived on the VIP)
  ansible.builtin.shell: >
    curl -sfL https://get.k3s.io |
    INSTALL_K3S_VERSION="{{ k3s_version }}" sh -s - server
    --server "https://{{ k3s_api_server }}:{{ k3s_api_port }}"
    --token "{{ vault_k3s_cluster_token }}"
    --flannel-backend=none
    --disable traefik
    --tls-san "{{ k3s_api_server }}"
    --etcd-s3
    --etcd-s3-config-secret "{{ etcd_s3_config_secret }}"
    --etcd-snapshot-schedule-cron "{{ etcd_snapshot_schedule_cron }}"
    --etcd-snapshot-retention "{{ etcd_snapshot_retention }}"
  when:
    - not k3s_already_running
    - cluster_exists | default(false)

# --- Path B: genuinely no cluster exists and no restore was requested — this node initializes fresh ---
- name: Check for a local cluster-init marker (belt-and-braces against accidental re-init)
  ansible.builtin.stat:
    path: /etc/rancher/k3s/cluster-initialized
  register: cluster_init_marker
  when:
    - not k3s_already_running
    - not (cluster_exists | default(false))
    - not (k3s_restore_from_snapshot | default(false))

- name: Initialize fresh HA control plane via cluster-init
  ansible.builtin.shell: >
    curl -sfL https://get.k3s.io |
    INSTALL_K3S_VERSION="{{ k3s_version }}" sh -s - server
    --cluster-init
    --token "{{ vault_k3s_cluster_token }}"
    --flannel-backend=none
    --disable traefik
    --disable servicelb
    --tls-san "{{ k3s_api_server }}"
    --etcd-s3
    --etcd-s3-config-secret "{{ etcd_s3_config_secret }}"
    --etcd-snapshot-schedule-cron "{{ etcd_snapshot_schedule_cron }}"
    --etcd-snapshot-retention "{{ etcd_snapshot_retention }}"
  register: cluster_init_result
  when: cluster_init_marker.stat is defined and not cluster_init_marker.stat.exists

- name: Record cluster-init marker so a later re-run can't accidentally re-initialize
  ansible.builtin.file:
    path: /etc/rancher/k3s/cluster-initialized
    state: touch
    mode: '0600'
  when: cluster_init_result is defined and cluster_init_result is not skipped

# --- Bring the service up, regardless of which of A/B was taken above ---
# Skipped for Path C — restore.yml already brings its own service up,
# since a restore needs different systemd/env-file handling (stripping
# the one-shot --cluster-reset flag) that A/B never touch.
- name: Ensure server service is up
  ansible.builtin.systemd:
    name: k3s
    state: started
    enabled: true
  when: not (k3s_did_restore | default(false))

- name: Wait for local API server port to accept connections
  ansible.builtin.wait_for:
    host: "127.0.0.1"
    port: "{{ k3s_api_port }}"
    delay: 5
    timeout: 60
  when: not (k3s_did_restore | default(false))

# --- Stand up kube-vip — only on a true fresh init. If this node rejoined
# an existing cluster (Path A), kube-vip's DaemonSet is already running
# cluster-wide. Path C applies its own copy inside restore.yml. ---
- name: Apply kube-vip manifest (auto-applied by K3s's own controller on this node)
  ansible.builtin.copy:
    src: files/kube-vip.yaml
    dest: /var/lib/rancher/k3s/server/manifests/kube-vip.yaml
    owner: root
    mode: '0644'
  when: cluster_init_result is defined and cluster_init_result is not skipped
</file>

</files>
