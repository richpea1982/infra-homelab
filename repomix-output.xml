<file path="ansible/roles/k3s_cluster/tasks/prereqs.yml">
---
- name: Ensure apt cache is up to date (Debian/Ubuntu)
  apt:
    update_cache: yes
  when: ansible_facts['pkg_mgr'] == 'apt'

- name: Install arptables and ebtables packages if available (Debian/Ubuntu)
  apt:
    name:
      - arptables
      - ebtables
      - iptables
      - iproute2
      - nfs-common
    state: present
  when: ansible_facts['pkg_mgr'] == 'apt'

- name: Check for legacy binary for each tool
  stat:
    path: "/usr/sbin/{{ item }}-legacy"
  register: legacy_stat
  loop:
    - iptables
    - ip6tables
    - arptables
    - ebtables
  loop_control:
    label: "{{ item }}"

- name: Set alternatives for tools that have a legacy binary present
  community.general.alternatives:
    name: "{{ item.item }}"
    path: "/usr/sbin/{{ item.item }}-legacy"
  loop: "{{ legacy_stat.results }}"
  when: item.stat.exists

- name: Warn when a legacy binary is missing (informational)
  debug:
    msg: "Legacy binary /usr/sbin/{{ item.item }}-legacy not found; skipping alternatives for {{ item.item }}"
  loop: "{{ legacy_stat.results }}"
  when: not item.stat.exists

- name: Ensure /etc/rancher/k3s directory exists
  file:
    path: /etc/rancher/k3s
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Ensure standard upstream nameserver fallback is declared
  copy:
    dest: /etc/rancher/k3s/resolv.conf
    content: |
      nameserver 1.1.1.1
      nameserver 8.8.8.8
    mode: '0644'
    owner: root
    group: root

- name: Turn off swap space completely for current session
  command: swapoff -a
  changed_when: false

- name: Disable swap in fstab persistently across reboots
  replace:
    path: /etc/fstab
    regexp: '^([^#].*\sswap\s.*)$'
    replace: '#\1'
</file>

