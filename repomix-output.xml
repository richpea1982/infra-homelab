<file path="ansible/roles/k3s_cluster/tasks/storageclass-retain.yml">
---
- name: Delete default local-path StorageClass
  kubernetes.core.k8s:
    state: absent
    kind: StorageClass
    name: local-path
  ignore_errors: true

- name: Apply retained StorageClass
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: storage.k8s.io/v1
      kind: StorageClass
      metadata:
        name: local-path
        annotations:
          storageclass.kubernetes.io/is-default-class: "true"
      provisioner: rancher.io/local-path
      volumeBindingMode: WaitForFirstConsumer
      reclaimPolicy: Retain
</file>

<file path="ansible/playbooks/deploy_k3s.yml">
---
- name: Refresh SSH host keys for K3s nodes
  hosts: localhost
  connection: local
  gather_facts: false
  tasks:
    - name: Remove stale known_hosts entries for both names and IPs
      ansible.builtin.command: >
         ssh-keygen -f /root/.ssh/known_hosts -R {{ item }}
      loop: "{{ groups['k3s_cluster'] + [hostvars[groups['k3s_cluster'][0]].ansible_host, hostvars[groups['k3s_cluster'][1]].ansible_host, hostvars[groups['k3s_cluster'][2]].ansible_host] }}"
      ignore_errors: true
      changed_when: true

    - name: Scan and trust the current SSH host key for each K3s node IP
      ansible.builtin.command: "ssh-keyscan -T 10 {{ hostvars[item]['ansible_host'] }}"
      with_items: "{{ groups['k3s_cluster'] }}"

- name: Orchestrate HA K3s Cluster Provisioning
  hosts: k3s_cluster
  become: true
  gather_facts: true
  vars_files:
    - ../group_vars/all/vault.yml

  roles:
    - role: ../roles/k3s_cluster
</file>

<file path="ansible/roles/k3s_cluster/tasks/join.yml">
---
- name: Check if K3s service is already active on this node
  ansible.builtin.systemd:
    name: k3s
  register: k3s_local_status
  failed_when: false

- name: Set fact — is K3s already running here?
  ansible.builtin.set_fact:
    k3s_already_running: "{{ k3s_local_status.status is defined and k3s_local_status.status.ActiveState == 'active' }}"

# Defensive cleanup before attempting a (re)join — closes the same gap
# found during the 2026-08 DR drill (stale TLS certs / db state from a
# previous node identity blocking a clean rejoin, discovered on nodes 2
# and 3 as well as the initial restore node). No-op on a genuinely fresh
# Terraform-provisioned VM.
- name: Defensive cleanup of any prior k3s state before joining
  ansible.builtin.include_tasks: cleanup-stale-state.yml
  when: not k3s_already_running

- name: Wait for the VIP to be reachable before attempting to join
  ansible.builtin.uri:
    url: "https://{{ k3s_api_server }}:{{ k3s_api_port }}/readyz"
    validate_certs: false
    status_code: [200, 401, 403]
    timeout: 5
  register: vip_probe
  retries: 30
  delay: 10
  until: (vip_probe.status | default(0)) in [200, 401, 403]
  when: not k3s_already_running

- name: Join existing cluster via the VIP
  ansible.builtin.shell: >
    curl -sfL https://get.k3s.io |
    INSTALL_K3S_VERSION="{{ k3s_version }}" sh -s - server
    --server "https://{{ k3s_api_server }}:{{ k3s_api_port }}"
    --token "{{ vault_k3s_cluster_token }}"
    --flannel-backend=none
    --disable traefik
    --tls-san "{{ k3s_api_server }}"
    --etcd-s3
    --etcd-s3-config-secret "{{ etcd_s3_config_secret }}"
    --etcd-snapshot-schedule-cron "{{ etcd_snapshot_schedule_cron }}"
    --etcd-snapshot-retention "{{ etcd_snapshot_retention }}"
  when: not k3s_already_running

- name: Ensure secondary k3s service engines are verified running
  ansible.builtin.systemd:
    name: k3s
    state: started
    enabled: true
</file>

