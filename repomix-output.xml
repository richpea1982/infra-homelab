            - name: vip_interface
              value: "eth0"
            - name: vip_cidr
              value: "24"
            - name: cp_enable
              value: "true"
            - name: cp_namespace
              value: "kube-system"
            - name: vip_ddns
              value: "false"
            - name: svc_enable
              value: "true"
            - name: svc_election
              value: "true"
            - name: svc_leasename
              value: "plndr-svcs-lock"
            - name: vip_leaderelection
              value: "true"
            - name: vip_leaseduration
              value: "15"
            - name: vip_renewdeadline
              value: "10"
            - name: vip_retryperiod
              value: "2"
            - name: address
