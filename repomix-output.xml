<file path="ansible/roles/nas_setup/tasks/minio.yml">
---
- name: Create MinIO system group
  group:
    name: "{{ minio_group }}"
    system: yes

- name: Create MinIO system user
  user:
    name: "{{ minio_user }}"
    group: "{{ minio_group }}"
    system: yes
    shell: /usr/sbin/nologin
    create_home: no

- name: Download MinIO binary
  get_url:
    url: "{{ minio_download_url }}"
    dest: /usr/local/bin/minio
    mode: '0755'
    owner: root
    group: root

- name: Ensure MinIO configuration directory exists
  file:
    path: /etc/minio
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Deploy MinIO environment configuration
  no_log: true
  copy: 
    dest: /etc/minio/minio.env
    content: |
      MINIO_VOLUMES="{{ nas_mount_point_base }}/minio"
      MINIO_OPTS="--address :9000 --console-address :9001"
      MINIO_ROOT_USER="{{ vault_minio_root_user }}"
      MINIO_ROOT_PASSWORD="{{ vault_minio_root_password }}"
    owner: root
    group: "{{ minio_group }}"
    mode: '0640'
  register: minio_env_updated

- name: Fix ownership of ZFS MinIO data directory
  file:
    path: "{{ nas_mount_point_base }}/minio"
    state: directory
    owner: "{{ minio_user }}"
    group: "{{ minio_group }}"
    recurse: no

- name: Deploy MinIO systemd service unit
  copy:
    dest: /etc/systemd/system/minio.service
    mode: '0644'
    content: |
      [Unit]
      Description=MinIO High Performance Object Storage
      Documentation=https://docs.min.io
      After=network.target
      AssertFileIsExecutable=/usr/local/bin/minio

      [Service]
      Type=simple
      User={{ minio_user }}
      Group={{ minio_group }}
      ProtectProc=invisible
      EnvironmentFile=/etc/minio/minio.env
      ExecStart=/usr/local/bin/minio server $MINIO_OPTS $MINIO_VOLUMES
      Restart=always
      LimitNOFILE=65536
      TasksMax=infinity
      TimeoutStopSec=infinity
      SendSIGKILL=no

      [Install]
      WantedBy=multi-user.target
  register: minio_service_updated

- name: Enable and start MinIO service
  systemd:
    name: minio
    state: started
    enabled: yes
    daemon_reload: "{{ minio_service_updated.changed }}"

- name: Restart MinIO if configuration changed
  systemd:
    name: minio
    state: restarted
  when: minio_env_updated.changed and not minio_service_updated.changed

- name: Wait for MinIO API to become responsive
  uri:
    url: "http://127.0.0.1:9000/minio/health/live"
    status_code: 200
  retries: 10
  delay: 3
  register: minio_health
  until: minio_health.status == 200

- name: Authenticate and provision Terraform state bucket on MinIO
  amazon.aws.s3_bucket:
    name: homelab-tf-state
    state: present
    # Enforce standard Object Locking parameters for native S3 transaction locks
    object_lock_enabled: true
    endpoint_url: "http://127.0.0.1:9000"
    aws_access_key: "{{ vault_minio_root_user }}"
    aws_secret_key: "{{ vault_minio_root_password }}"
</file>

<file path="ansible/roles/nas_setup/tasks/packages.yml">
---
- name: Ensure contrib component is added to Debian sources
  replace:
    path: /etc/apt/sources.list
    regexp: '(deb http:\/\/deb\.debian\.org\/debian\/ {{ ansible_facts["distribution_release"] }} main)(?! contrib)'
    replace: '\1 contrib'
  become: true  # <--- Force it right here explicitly
  register: apt_sources_updated

- name: Run apt update if sources changed
  apt:
    update_cache: yes
  become: true
  when: apt_sources_updated.changed

- name: Run apt upgrade
  apt:
    upgrade: dist
    cache_valid_time: 3600
  become: true

- name: Install Kernel Headers, DKMS, and build tools
  apt:
    name:
      - "linux-headers-{{ ansible_facts['kernel'] }}"
      - dkms
      - build-essential
    state: present

- name: Install SMB, NFS, and ZFS utilities
  apt:
    name: "{{ nas_packages }}"
    state: present
  become: true
</file>

<file path="ansible/roles/nas_setup/tasks/zfs.yml">
---
- name: Apply ZFS ARC limits to protect 8GB host memory
  copy:
    dest: /etc/modprobe.d/zfs.conf
    content: |
      options zfs zfs_arc_max=2147483648
      options zfs zfs_arc_min=1073741824
    owner: root
    group: root
    mode: '0644'
  register: zfs_conf_updated

- name: Update initramfs if ZFS configuration changed
  command: update-initramfs -u
  when: zfs_conf_updated.changed

- name: Ensure ZFS kernel module is loaded
  modprobe:
    name: zfs
    state: present

- name: Ensure parent mount directory exists
  file:
    path: "{{ nas_mount_point_base }}"
    state: directory
    mode: '0755'

- name: Check if ZFS pool already exists
  command: "zpool list {{ nas_pool_name }}"
  register: zpool_check
  failed_when: false
  changed_when: false

- name: Create RAID-Z2 ZPOOL with optimized NAS options
  command: >
    zpool create -f
    -o ashift=12
    -O compression=lz4
    -O xattr=sa
    -O acltype=posixacl
    -O atime=off
    -O mountpoint=none
    {{ nas_pool_name }} raidz2
    {{ zfs_raidz2_disks | join(' ') }}
  when: zpool_check.rc != 0

- name: Create ZFS Datasets with Tailored Options
  community.general.zfs:
    name: "{{ nas_pool_name }}/{{ item.name }}"
    state: present
    extra_zfs_properties:
      mountpoint: "{{ nas_mount_point_base }}/{{ item.name }}"
      recordsize: "{{ item.recordsize | default('128k') }}"
  loop: "{{ nas_datasets }}"
</file>

