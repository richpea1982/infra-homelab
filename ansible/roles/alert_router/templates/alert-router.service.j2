[Unit]
Description=Homelab Alert Router (Alertmanager -> Semaphore DR trigger)
After=network.target semaphore.service
Wants=semaphore.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/alert-router.env
ExecStart=/opt/alert-router/venv/bin/uvicorn main:app --app-dir /opt/alert-router --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
